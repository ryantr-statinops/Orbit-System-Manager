# -----------------------------------------------------------------------------
# Orbit System Manager — Slint Linux Native Build Container
# Builds standalone native Linux binary with Slint GUI
# -----------------------------------------------------------------------------

FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH="/usr/local/cargo/bin:/usr/local/bin:$PATH"

# 1. Install Linux C-libraries required by Slint (Fontconfig, X11, Wayland, OpenGL)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    curl \
    ca-certificates \
    libfontconfig1-dev \
    libx11-dev \
    libxkbcommon-dev \
    libwayland-dev \
    libxrandr-dev \
    libxi-dev \
    libgl1-mesa-dev \
    libegl1-mesa-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable

WORKDIR /app

# 3. Copy source and build native release binary
COPY . .
RUN cargo build --locked --release

CMD ["cp", "target/release/orbit-system-manager", "/output/"]
