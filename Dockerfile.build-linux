# -----------------------------------------------------------------------------
# Orbit System Manager — Linux Build Container
# Builds standalone .deb and .AppImage packages for Linux distributions
# -----------------------------------------------------------------------------

FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH="/usr/local/cargo/bin:/usr/local/bin:$PATH"

# 1. Install Linux C-libraries required by Tauri v2 and WebKitGTK
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    wget \
    file \
    libssl-dev \
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    ca-certificates \
    git \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable

# 3. Install Node.js (LTS v20)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 4. Copy package manifests first for caching
COPY package.json package-lock.json ./
RUN npm ci

# 5. Copy project source
COPY . .

# 6. Build script: frontend bundle + tauri packages
CMD ["bash", "-c", "npm run build && npx tauri build --bundles deb,appimage"]
