// Orbit System Manager premium dark design system.

export global Theme {
    // Surfaces
    in-out property <color> app_bg: #1e1e1e;
    in-out property <color> editor_bg: #202020;
    in-out property <color> card_bg: #252526;
    in-out property <color> hover_bg: #2a2d2e;
    in-out property <color> active_bg: #094771;
    in-out property <color> sub_card_bg: #2d2d30;
    in-out property <color> progress_track: #3c3c3c;

    // Borders, spacing and shape
    in-out property <color> border: #3c3c3c;
    in-out property <color> border_focus: #0e639c;
    in-out property <color> divider: #323232;
    in-out property <length> radius_sm: 8px;
    in-out property <length> radius_md: 8px;
    in-out property <length> space_xs: 4px;
    in-out property <length> space_sm: 8px;
    in-out property <length> space_md: 12px;
    in-out property <length> space_lg: 20px;

    // Typography
    in-out property <color> text_primary: #f5f7fb;
    in-out property <color> text_secondary: #c3cedd;
    in-out property <color> text_muted: #b3c0d2;
    in-out property <color> text_on_accent: #ffffff;

    // Semantic accents
    in-out property <color> accent: #67b7ff;
    in-out property <color> accent_cyan: #63d6e8;
    in-out property <color> teal_primary: #53d6c2;
    in-out property <color> success: #64d7a1;
    in-out property <color> warning: #f2bd62;
    in-out property <color> danger: #ff7185;
    in-out property <color> purple: #bd9bff;

    // -------------------------------------------------------------
    // Synchronized Gradient Spectrum Brushes
    // -------------------------------------------------------------
    // Canonical Viridis stops shared by the UI gradient and Rust renderer.
    in-out property <color> viridis_0: #440154;
    in-out property <color> viridis_25: #3b528b;
    in-out property <color> viridis_50: #21918c;
    in-out property <color> viridis_75: #5ec962;
    in-out property <color> viridis_100: #fde725;
    in-out property <brush> gradient_viridis: @linear-gradient(90deg, viridis_0 0%, viridis_25 25%, viridis_50 50%, viridis_75 75%, viridis_100 100%);
    in-out property <brush> gradient_cpu: @linear-gradient(90deg, viridis_25 0%, viridis_50 50%, viridis_100 100%);
    in-out property <brush> gradient_ram: @linear-gradient(90deg, #0969da 0%, #58a6ff 60%, #79c0ff 100%);
    in-out property <brush> gradient_gpu: @linear-gradient(90deg, #9e6a03 0%, #d29922 60%, #fde725 100%);
    in-out property <brush> gradient_net: @linear-gradient(90deg, #8957e5 0%, #bc8cff 60%, #e2c5ff 100%);

    // 3D viewport
    in-out property <color> viewport_bg: #111111;
    in-out property <color> viewport_border: #343434;

    pure function interpolate_color(first: color, second: color, amount: float) -> color {
        let amount_1000 = Math.round(Math.max(0.0, Math.min(1.0, amount)) * 1000.0);
        return rgb(
            (first.red * (1000 - amount_1000) + second.red * amount_1000 + 500) / 1000,
            (first.green * (1000 - amount_1000) + second.green * amount_1000 + 500) / 1000,
            (first.blue * (1000 - amount_1000) + second.blue * amount_1000 + 500) / 1000
        );
    }

    // Interpolate through the same five stops used by the Rust surface renderer.
    public pure function viridis_color_for_load(load: float) -> color {
        let value = Math.max(0.0, Math.min(100.0, load));
        if (value < 25.0) { return interpolate_color(viridis_0, viridis_25, value / 25.0); }
        if (value < 50.0) { return interpolate_color(viridis_25, viridis_50, (value - 25.0) / 25.0); }
        if (value < 75.0) { return interpolate_color(viridis_50, viridis_75, (value - 50.0) / 25.0); }
        return interpolate_color(viridis_75, viridis_100, (value - 75.0) / 25.0);
    }
}
