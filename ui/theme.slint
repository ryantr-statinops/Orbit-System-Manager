// Orbit System Manager — VS Code Minimalist Dark Theme
// Design Tokens & Synchronized Gradient Palettes

export global Theme {
    // Base Surfaces (VS Code editor & sidebar colors)
    in-out property <color> app_bg: #181818;          // VS Code sidebar & shell background
    in-out property <color> editor_bg: #1e1e1e;       // VS Code main editor background
    in-out property <color> card_bg: #222222;         // Minimalist card surface
    in-out property <color> hover_bg: #2a2d2e;        // VS Code list hover background
    in-out property <color> active_bg: #04395e;       // VS Code active selection background
    in-out property <color> sub_card_bg: #252526;     // Sub-panel background
    in-out property <color> progress_track: #2a2a2a;  // Meter track background

    // Borders & Dividers (Subtle 1px flat borders)
    in-out property <color> border: #2d2d2d;
    in-out property <color> border_focus: #0078d4;
    in-out property <color> divider: #282828;
    in-out property <length> radius_sm: 3px;
    in-out property <length> radius_md: 6px;

    // Typography (VS Code text colors)
    in-out property <color> text_primary: #d4d4d4;
    in-out property <color> text_secondary: #9da5b4;
    in-out property <color> text_muted: #6e7681;
    in-out property <color> text_on_accent: #ffffff;

    // VS Code Semantic Syntax Accents
    in-out property <color> accent: #0078d4;          // VS Code standard blue
    in-out property <color> accent_cyan: #4fc1ff;     // VS Code light blue
    in-out property <color> teal_primary: #4ec9b0;    // VS Code teal
    in-out property <color> success: #89d185;         // VS Code green
    in-out property <color> warning: #cca700;         // VS Code warning yellow
    in-out property <color> danger: #f14c4c;          // VS Code error red
    in-out property <color> purple: #c586c0;          // VS Code keyword purple

    // -------------------------------------------------------------
    // Synchronized Gradient Spectrum Brushes
    // -------------------------------------------------------------
    // Canonical 3D Viridis spectrum matching the 3D mesh shader
    in-out property <brush> gradient_viridis: @linear-gradient(90deg, #440154 0%, #3b528b 25%, #21918c 50%, #5ec962 75%, #fde725 100%);
    in-out property <brush> gradient_cpu: @linear-gradient(90deg, #3b528b 0%, #21918c 50%, #fde725 100%);
    in-out property <brush> gradient_ram: @linear-gradient(90deg, #0969da 0%, #58a6ff 60%, #79c0ff 100%);
    in-out property <brush> gradient_gpu: @linear-gradient(90deg, #9e6a03 0%, #d29922 60%, #fde725 100%);
    in-out property <brush> gradient_net: @linear-gradient(90deg, #8957e5 0%, #bc8cff 60%, #e2c5ff 100%);

    // 3D Viewport Colors
    in-out property <color> viewport_bg: #141414;
    in-out property <color> viewport_border: #282828;

    // Font family
    in-out property <string> default_font: "Consolas, 'Segoe UI', Inter, system-ui, monospace";

    // Synchronized Viridis Color Calculator (Maps 0.0 - 100.0 load to Viridis Palette)
    public pure function viridis_color_for_load(load: float) -> color {
        if (load >= 87.5) { return #fde725; }
        if (load >= 62.5) { return #5ec962; }
        if (load >= 37.5) { return #21918c; }
        if (load >= 12.5) { return #3b528b; }
        return #440154;
    }
}
