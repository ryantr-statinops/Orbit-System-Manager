// Orbit System Manager — Slint Theme Definition
// Design Tokens & Customizable Palette (Dark Theme Default)

export global Theme {
    // Base Backgrounds
    in-out property <color> app_bg: #0d1117;
    in-out property <color> card_bg: #161b22;
    in-out property <color> card_header_bg: #1c2128;
    in-out property <color> sub_card_bg: #21262d;
    in-out property <color> progress_track: #21262d;

    // Borders & Dividers
    in-out property <color> border: #30363d;
    in-out property <color> border_highlight: #388bfd;
    in-out property <length> radius_sm: 4px;
    in-out property <length> radius_md: 8px;
    in-out property <length> radius_lg: 12px;

    // Typography Colors
    in-out property <color> text_primary: #f0f6fc;
    in-out property <color> text_secondary: #8b949e;
    in-out property <color> text_muted: #6e7681;
    in-out property <color> text_on_accent: #ffffff;

    // Status & Telemetry Semantic Colors
    in-out property <color> accent: #58a6ff;
    in-out property <color> teal_primary: #21918c;
    in-out property <color> success: #3fb950;
    in-out property <color> warning: #d29922;
    in-out property <color> danger: #f85149;
    in-out property <color> purple: #a371f7;

    // 3D Viewport Colors
    in-out property <color> viewport_bg: #090d13;
    in-out property <color> viewport_border: #30363d;

    // Typography
    in-out property <string> default_font: "Segoe UI, Inter, system-ui, -apple-system, sans-serif";
}
