// CoreMatrix Component — 16 CPU Logical Processors 8x2 Matrix with Synchronized Viridis Gradient
import { Theme } from "../theme.slint";
import { CoreItem } from "core_bar.slint";

export struct CoreRow {
    cells: [CoreItem],
}

export component CoreCell inherits Rectangle {
    in property <int> id: 0;
    in property <float> load: 0.0;

    height: 26px;
    background: Theme.card_bg;
    border-radius: Theme.radius_sm;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 6px;
        Text {
            text: root.id < 10 ? "C0" + root.id : "C" + root.id;
            width: 26px;
            font-size: 12px;
            font-weight: 700;
            color: Theme.text_muted;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 4px;
            background: Theme.progress_track;
            border-radius: 1px;
            clip: true;
            Rectangle {
                width: Math.min(parent.width, Math.max(0px, parent.width * (root.load / 100.0)));
                height: parent.height;
                background: Theme.viridis_color_for_load(root.load);
                animate width { duration: 250ms; easing: ease-out; }
            }
        }
        Text {
            text: Math.round(root.load) + "%";
            width: 36px;
            font-size: 12px;
            font-weight: 700;
            color: Theme.viridis_color_for_load(root.load);
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

export component CoreMatrix inherits VerticalLayout {
    in property <[CoreRow]> rows;
    spacing: 6px;

    for row in root.rows: HorizontalLayout {
        spacing: 6px;
        for item in row.cells: CoreCell {
            id: item.id;
            load: item.load;
        }
    }
}
