import { Theme } from "../theme.slint";

export component DashboardAction inherits Rectangle {
    in property <string> text;
    in property <string> accessible_name;
    in property <brush> button_background: Theme.hover_bg;
    callback activated();

    background: root.button_background;
    min-width: 0px;
    min-height: 0px;
    border-width: keyboard_focus.has-focus ? 2px : 1px;
    border-color: keyboard_focus.has-focus ? Theme.accent_cyan : Theme.border;
    border-radius: 4px;
    accessible-role: button;
    accessible-label: root.accessible_name;
    accessible-action-default => { root.activated(); }
    forward-focus: keyboard_focus;

    keyboard_focus := FocusScope {
        width: 0px;
        height: 0px;

        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    Text {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        text: root.text;
        color: Theme.text_primary;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch_area := TouchArea {
        width: parent.width;
        height: parent.height;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                keyboard_focus.focus();
            }
        }
        clicked => { root.activated(); }
    }
}
