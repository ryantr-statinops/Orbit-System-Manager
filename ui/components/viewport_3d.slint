// Viewport3D Component — VS Code Minimalist 3D Topology Viewport Frame
import { Theme } from "../theme.slint";

export component Viewport3D inherits Rectangle {
    in property <image> frame;
    in property <bool> has_frame: false;
    in property <float> cpu_avg: 0.0;
    in property <float> cpu_std: 0.0;
    in property <float> cpu_var: 0.0;
    in property <bool> cpu_available: false;
    in property <int> cpu_logical_count: 0;
    in property <int> history_samples: 0;
    in property <int> history_seconds: 0;

    // Callbacks to Rust 3D Camera OrbitControls
    callback rotate_drag(length, length);
    callback pan_drag(length, length);
    callback zoom_scroll(length);
    callback resize_viewport(length, length);
    callback reset_view();

    background: Theme.editor_bg;
    border-radius: Theme.radius_sm;
    clip: true;

    VerticalLayout {
        spacing: 8px;

        // Header: Task Manager Title & Real-time KPIs
        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "CPU";
                        font-size: 18px;
                        font-weight: 800;
                        color: Theme.text_primary;
                    }
                    Text {
                        text: root.cpu_available ? Math.round(root.cpu_avg * 10.0) / 10.0 + "% Utilization" : "N/A";
                        font-size: 15px;
                        font-weight: 700;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.history_samples > 0 ? "" + root.history_samples + " of 30 samples • " + root.history_seconds + "s history • " + root.cpu_logical_count + " processors" : "Waiting for CPU data";
                    font-size: 11px;
                    color: Theme.text_muted;
                }
            }

            // Top-right status tags
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                Rectangle {
                    background: Theme.card_bg;
                    border-radius: Theme.radius_sm;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        Text {
                            text: "" + root.history_samples + "/30 samples • " + root.history_seconds + "s";
                            font-size: 10px;
                            font-weight: 600;
                            color: Theme.teal_primary;
                        }
                    }
                }
                Rectangle {
                    background: Theme.hover_bg;
                    border-radius: Theme.radius_sm;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        Text { text: "Reset view"; font-size: 10px; font-weight: 600; color: Theme.text_primary; }
                    }
                    TouchArea { clicked => { root.reset_view(); } }
                }
                Rectangle {
                    background: Theme.card_bg;
                    border-radius: Theme.radius_sm;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        Text {
                        text: "CPU-rendered • up to 30 FPS";
                            font-size: 10px;
                            font-weight: 600;
                            color: Theme.success;
                        }
                    }
                }
            }
        }

        // 3D Canvas Container
        canvas := Rectangle {
            height: 318px;
            background: Theme.viewport_bg;
            border-radius: Theme.radius_sm;
            border-width: 1px;
            border-color: Theme.viewport_border;
            clip: true;
            changed width => { root.resize_viewport(self.width, self.height); }
            changed height => { root.resize_viewport(self.width, self.height); }

            // Rendered Frame Image
            if root.has_frame: Image {
                source: root.frame;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            // Fallback placeholder when frame buffer is loading
            if !root.has_frame: VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: "🌐";
                    font-size: 38px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "CPU TELEMETRY HISTORY";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.teal_primary;
                    horizontal-alignment: center;
                    letter-spacing: 1px;
                }
                Text {
                    text: "Left drag to rotate • Right drag to pan • Scroll to zoom";
                    font-size: 10px;
                    color: Theme.text_muted;
                    horizontal-alignment: center;
                }
            }

            // Interactive TouchArea capturing Orbit Controls
            touch_area := TouchArea {
                property <length> last_x: 0px;
                property <length> last_y: 0px;
                property <PointerEventButton> drag_button: PointerEventButton.left;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        self.last_x = self.mouse-x;
                        self.last_y = self.mouse-y;
                        self.drag_button = event.button;
                    }
                }

                moved => {
                    if (self.pressed) {
                        if (self.drag_button == PointerEventButton.left) {
                            root.rotate_drag(self.mouse-x - self.last_x, self.mouse-y - self.last_y);
                        } else if (self.drag_button == PointerEventButton.right) {
                            root.pan_drag(self.mouse-x - self.last_x, self.mouse-y - self.last_y);
                        }
                        self.last_x = self.mouse-x;
                        self.last_y = self.mouse-y;
                    }
                }

                scroll-event(event) => {
                    root.zoom_scroll(event.delta-y);
                    return EventResult.accept;
                }
            }
        }

        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "LOGICAL PROCESSORS →";
                font-size: 9px;
                font-weight: 700;
                color: Theme.text_secondary;
            }
            Text {
                text: root.history_samples > 0 ? "TIME → LAST " + root.history_seconds + "s" : "TIME → WAITING FOR SAMPLES";
                font-size: 9px;
                font-weight: 700;
                color: Theme.text_secondary;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            Text { text: "UTILIZATION"; font-size: 9px; font-weight: 700; color: Theme.text_secondary; }
            Text { text: "0%"; font-size: 9px; color: #440154; }
            Rectangle { width: 180px; height: 5px; border-radius: 2px; background: Theme.gradient_viridis; }
            Text { text: "100%"; font-size: 9px; color: #fde725; }
        }
    }
}
