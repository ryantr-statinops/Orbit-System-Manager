// Viewport3D Component — VS Code Minimalist 3D Topology Viewport Frame
import { Theme } from "../theme.slint";
import { DashboardAction } from "dashboard_action.slint";

export struct TerrainAxisLabel {
    x: length,
    y: length,
    width: length,
    text: string,
    color: color,
    is_axis_title: bool,
}

export component Viewport3D inherits Rectangle {
    in property <image> frame;
    in property <bool> has_frame: false;
    in property <float> cpu_avg: 0.0;
    in property <float> cpu_std: 0.0;
    in property <float> cpu_var: 0.0;
    in property <bool> cpu_available: false;
    in property <int> cpu_logical_count: 0;
    in property <int> history_samples: 0;
    in property <int> history_seconds: 0;
    in property <[TerrainAxisLabel]> axis_labels: [];

    // Callbacks to Rust 3D Camera OrbitControls
    callback rotate_drag(length, length);
    callback pan_drag(length, length);
    callback zoom_scroll(length);
    callback resize_viewport(length, length);
    callback reset_view();

    background: Theme.editor_bg;
    min-width: 0px;
    border-radius: Theme.radius_sm;
    clip: true;

    VerticalLayout {
        padding: Theme.space_md;
        spacing: Theme.space_sm;

        // Header and status tags use independent rows so their preferred widths
        // do not depend on the viewport's own responsive width.
        VerticalLayout {
            spacing: Theme.space_xs;
            Text {
                text: "CPU Utilization Surface";
                font-size: 14px;
                font-weight: 700;
                color: Theme.text_primary;
            }
            Text {
                text: root.history_samples > 0 ? "" + root.history_samples + " samples • " + root.history_seconds + "s history • " + root.cpu_logical_count + " processors" : "Waiting for CPU data";
                font-size: 12px;
                color: Theme.text_muted;
            }
            HorizontalLayout {
                spacing: Theme.space_xs;
                Rectangle {
                    background: Theme.hover_bg;
                    border-radius: Theme.radius_sm;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: Theme.space_sm;
                        padding-right: Theme.space_sm;
                        padding-top: Theme.space_xs;
                        padding-bottom: Theme.space_xs;
                        Text { text: root.cpu_logical_count + " CORES"; font-size: 10px; font-weight: 600; color: Theme.text_secondary; }
                    }
                }
                Rectangle {
                    background: Theme.hover_bg;
                    border-radius: Theme.radius_sm;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: Theme.space_sm;
                        padding-right: Theme.space_sm;
                        padding-top: Theme.space_xs;
                        padding-bottom: Theme.space_xs;
                        Text { text: root.history_samples > 0 ? root.history_seconds + "s WINDOW" : "WAITING"; font-size: 10px; font-weight: 600; color: Theme.text_secondary; }
                    }
                }
                Rectangle {
                    background: Theme.hover_bg;
                    border-radius: Theme.radius_sm;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: Theme.space_sm;
                        padding-right: Theme.space_sm;
                        padding-top: Theme.space_xs;
                        padding-bottom: Theme.space_xs;
                        Text { text: "VIRIDIS THERMAL"; font-size: 10px; font-weight: 600; color: Theme.teal_primary; }
                    }
                }
            }
        }

        // 3D Canvas Container
        canvas := Rectangle {
            min-height: 0px;
            vertical-stretch: 1;
            background: Theme.viewport_bg;
            border-radius: Theme.radius_sm;
            border-width: 1px;
            border-color: Theme.viewport_border;
            clip: true;
            changed width => { root.resize_viewport(self.width, self.height); }
            changed height => { root.resize_viewport(self.width, self.height); }

            // Rendered Frame Image
            if root.has_frame: Image {
                source: root.frame;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            for label in root.axis_labels: Text {
                x: label.x;
                y: label.y;
                width: label.width;
                height: 14px;
                text: label.text;
                color: label.color;
                font-size: label.is_axis_title ? 10px : 9px;
                font-weight: label.is_axis_title ? 700 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Fallback placeholder when frame buffer is loading
            if !root.has_frame: VerticalLayout {
                alignment: center;
                spacing: Theme.space_xs;
                Text {
                    text: "🌐";
                    font-size: 38px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "CPU TELEMETRY HISTORY";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.teal_primary;
                    horizontal-alignment: center;
                    letter-spacing: 1px;
                }
                Text {
                    text: "Left drag to rotate • Right drag to pan • Scroll to zoom";
                    font-size: 10px;
                    color: Theme.text_muted;
                    horizontal-alignment: center;
                }
            }

            // Interactive TouchArea capturing Orbit Controls
            touch_area := TouchArea {
                property <length> last_x: 0px;
                property <length> last_y: 0px;
                property <PointerEventButton> drag_button: PointerEventButton.left;
                property <bool> dragging: false;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        self.last_x = self.mouse-x;
                        self.last_y = self.mouse-y;
                        self.drag_button = event.button;
                        self.dragging = event.button == PointerEventButton.left || event.button == PointerEventButton.right;
                    }
                    if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        self.dragging = false;
                    }
                }

                moved => {
                    if (!self.pressed) {
                        self.dragging = false;
                    } else if (self.dragging) {
                        if (self.drag_button == PointerEventButton.left) {
                            root.rotate_drag(self.mouse-x - self.last_x, self.mouse-y - self.last_y);
                        } else if (self.drag_button == PointerEventButton.right) {
                            root.pan_drag(self.mouse-x - self.last_x, self.mouse-y - self.last_y);
                        }
                        self.last_x = self.mouse-x;
                        self.last_y = self.mouse-y;
                    }
                }

                scroll-event(event) => {
                    root.zoom_scroll(event.delta-y);
                    return EventResult.accept;
                }
            }
        }

        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "LOGICAL PROCESSORS →";
                font-size: 10px;
                font-weight: 700;
                color: Theme.text_secondary;
            }
            Text {
                text: root.history_samples > 0 ? "TIME → LAST " + root.history_seconds + "s" : "TIME → WAITING FOR SAMPLES";
                font-size: 10px;
                font-weight: 700;
                color: Theme.text_secondary;
            }
        }
        HorizontalLayout {
            spacing: Theme.space_xs;
            alignment: center;
            Text { text: "Utilization"; font-size: 10px; font-weight: 700; color: Theme.text_secondary; }
            Text { text: "0%"; font-size: 9px; color: Theme.viridis_0; }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Rectangle { height: 5px; border-radius: 2px; background: Theme.gradient_viridis; }
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "25%"; font-size: 9px; color: Theme.viridis_25; }
                    Text { text: "50%"; font-size: 9px; color: Theme.viridis_50; }
                    Text { text: "75%"; font-size: 9px; color: Theme.viridis_75; }
                }
            }
            Text { text: "100%"; font-size: 9px; color: Theme.viridis_100; }
        }
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "Left drag rotate • Right drag pan • Scroll zoom";
                font-size: 10px;
                color: Theme.text_secondary;
                vertical-alignment: center;
            }
            DashboardAction {
                width: 84px;
                height: 30px;
                text: "Reset view";
                accessible_name: "Reset terrain camera view";
                button_background: Theme.active_bg;
                activated => { root.reset_view(); }
            }
        }
    }
}
