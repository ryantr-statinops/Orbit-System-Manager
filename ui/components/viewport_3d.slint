// Viewport3D Component — VS Code Minimalist 3D Topology Viewport Frame
import { Theme } from "../theme.slint";

export component Viewport3D inherits Rectangle {
    in property <image> frame;
    in property <bool> has_frame: false;
    in property <float> cpu_avg: 0.0;
    in property <float> cpu_std: 0.0;
    in property <float> cpu_var: 0.0;

    // Callbacks to Rust 3D Camera OrbitControls
    callback rotate_drag(length, length);
    callback pan_drag(length, length);
    callback zoom_scroll(length);

    background: Theme.editor_bg;
    border-radius: Theme.radius_sm;
    clip: true;

    VerticalLayout {
        spacing: 8px;

        // Header: Task Manager Title & Real-time KPIs
        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "CPU";
                        font-size: 18px;
                        font-weight: 800;
                        color: Theme.text_primary;
                    }
                    Text {
                        text: Math.round(root.cpu_avg * 10.0) / 10.0 + "% Utilization";
                        font-size: 15px;
                        font-weight: 700;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: "16 Logical Processors • 60s Window • Real-time Hardware Sampling";
                    font-size: 11px;
                    color: Theme.text_muted;
                }
            }

            // Top-right status tags
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                Rectangle {
                    background: Theme.card_bg;
                    border-radius: Theme.radius_sm;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        Text {
                            text: "16C × 30S VIRIDIS";
                            font-size: 10px;
                            font-weight: 600;
                            color: Theme.teal_primary;
                        }
                    }
                }
                Rectangle {
                    background: Theme.card_bg;
                    border-radius: Theme.radius_sm;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        Text {
                            text: "VSYNC 60 FPS";
                            font-size: 10px;
                            font-weight: 600;
                            color: Theme.success;
                        }
                    }
                }
        }

        // 3D Canvas Container
        Rectangle {
            background: Theme.viewport_bg;
            border-radius: Theme.radius_sm;
            border-width: 1px;
            border-color: Theme.viewport_border;
            clip: true;

            // Rendered Frame Image
            if root.has_frame: Image {
                source: root.frame;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            // Fallback placeholder when frame buffer is loading
            if !root.has_frame: VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: "🌐";
                    font-size: 38px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "NATIVE 3D GPU TOPOLOGY MESH";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.teal_primary;
                    horizontal-alignment: center;
                    letter-spacing: 1px;
                }
                Text {
                    text: "Drag left-click to Orbit • Scroll to Zoom • Drag right-click to Pan";
                    font-size: 10px;
                    color: Theme.text_muted;
                    horizontal-alignment: center;
                }
            }

            // Interactive TouchArea capturing Orbit Controls
            touch_area := TouchArea {
                property <length> last_x: 0px;
                property <length> last_y: 0px;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        self.last_x = self.mouse-x;
                        self.last_y = self.mouse-y;
                    }
                }

                moved => {
                    if (self.pressed) {
                        root.rotate_drag(self.mouse-x - self.last_x, self.mouse-y - self.last_y);
                        self.last_x = self.mouse-x;
                        self.last_y = self.mouse-y;
                    }
                }

                scroll-event(event) => {
                    root.zoom_scroll(event.delta-y);
                    return EventResult.accept;
                }
            }
        }

        // Synchronized Viridis Gradient Legend Strip
        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            Text {
                text: "0% (Idle)";
                font-size: 9px;
                font-weight: 600;
                color: #3b528b;
                vertical-alignment: center;
            }
            Rectangle {
                width: 260px;
                height: 4px;
                border-radius: 2px;
                background: Theme.gradient_viridis;
            }
            Text {
                text: "100% (Peak)";
                font-size: 9px;
                font-weight: 700;
                color: #fde725;
                vertical-alignment: center;
            }
        }
    }
}
