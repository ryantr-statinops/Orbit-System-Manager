import { Theme } from "../theme.slint";

export component DashboardRightPanel inherits Rectangle {
    in property <float> ram_percent: 0.0;
    in property <bool> ram_available: false;
    in property <float> ram_used_gb: 0.0;
    in property <float> ram_total_gb: 0.0;
    in property <float> net_sent_kib: 0.0;
    in property <float> net_recv_kib: 0.0;
    in property <bool> network_available: false;
    in property <string> network_status_text: "Collecting first sample";

    background: transparent;
    VerticalLayout {
        spacing: 8px;

        Rectangle {
            height: 205px;
            background: Theme.card_bg;
            border-radius: Theme.radius_sm;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 12px;
                spacing: 10px;
                Text { text: "SYSTEM MEMORY (RAM)"; font-size: 11px; font-weight: 700; color: Theme.text_secondary; }
                Text {
                    text: root.ram_available ? Math.round(root.ram_used_gb * 10.0) / 10.0 + " / " + Math.round(root.ram_total_gb * 10.0) / 10.0 + " GiB (" + Math.round(root.ram_percent) + "%)" : "Unavailable";
                    overflow: elide;
                    font-size: 12px;
                    color: Theme.text_primary;
                }
                Rectangle {
                    height: 18px;
                    background: Theme.progress_track;
                    clip: true;
                    Rectangle {
                        width: parent.width * Math.max(0.0, Math.min(100.0, root.ram_percent)) / 100.0;
                        height: parent.height;
                        background: Theme.teal_primary;
                        animate width { duration: 250ms; easing: ease-out; }
                    }
                }
                Text { text: root.ram_available ? "Memory usage" : "Memory telemetry unavailable"; font-size: 10px; color: Theme.text_muted; }
            }
        }

        Rectangle {
            height: 250px;
            background: Theme.card_bg;
            border-radius: Theme.radius_sm;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 12px;
                spacing: 10px;
                Text { text: "GPU TELEMETRY"; font-size: 11px; font-weight: 700; color: Theme.text_secondary; }
                Text { text: "Unavailable"; font-size: 15px; font-weight: 700; color: Theme.warning; }
                Rectangle { height: 1px; background: Theme.border; }
                Text { text: "GPU monitoring is not supported by the current collector."; wrap: word-wrap; font-size: 11px; color: Theme.text_muted; }
            }
        }

        Rectangle {
            height: 190px;
            background: Theme.card_bg;
            border-radius: Theme.radius_sm;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 12px;
                spacing: 9px;
                Text { text: "NETWORK SPEEDS"; font-size: 11px; font-weight: 700; color: Theme.text_secondary; }
                Rectangle { height: 1px; background: Theme.border; }
                Text { text: "RECEIVE"; font-size: 10px; font-weight: 700; color: Theme.text_muted; }
                Text { text: root.network_available ? Math.round(root.net_recv_kib * 10.0) / 10.0 + " KiB/s" : root.network_status_text; font-size: 17px; font-weight: 700; color: Theme.purple; }
                Text { text: root.network_available ? "SEND  " + Math.round(root.net_sent_kib * 10.0) / 10.0 + " KiB/s • all interfaces" : "Send unavailable"; overflow: elide; font-size: 10px; color: Theme.text_secondary; }
            }
        }
    }
}
