import { Theme } from "../theme.slint";
import { SectionHeading } from "section_heading.slint";
import { ScrollView } from "std-widgets.slint";

export component DashboardRightPanel inherits Rectangle {
    in property <float> ram_percent: 0.0;
    in property <bool> ram_available: false;
    in property <float> ram_used_gb: 0.0;
    in property <float> ram_total_gb: 0.0;
    in property <string> ram_status_text: "Waiting for samples";
    in property <float> net_sent_kib: 0.0;
    in property <float> net_recv_kib: 0.0;
    in property <bool> network_available: false;
    in property <string> network_status_text: "Collecting first sample";
    in property <string> gpu_name: "Demo GPU";
    in property <bool> gpu_available: true;
    in property <string> gpu_status_text: "Demo data";
    in property <float> gpu_utilization: 0.0;
    in property <float> gpu_vram_used_gib: 0.0;
    in property <float> gpu_vram_total_gib: 8.0;
    in property <float> gpu_temperature_c: 0.0;
    in property <float> gpu_clock_mhz: 0.0;

    background: transparent;
    ScrollView {
        width: parent.width;
        height: parent.height;
        VerticalLayout {
        spacing: Theme.space_sm;

        Rectangle {
            min-height: 150px;
            vertical-stretch: 1;
            background: Theme.card_bg;
            border-radius: Theme.radius_sm;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.space_md;
                spacing: Theme.space_sm;
                SectionHeading { title: "SYSTEM MEMORY (RAM)"; icon: "memory"; }
                Text {
                    text: root.ram_available ? Math.round(root.ram_used_gb * 10.0) / 10.0 + " / " + Math.round(root.ram_total_gb * 10.0) / 10.0 + " GiB (" + Math.round(root.ram_percent) + "%)" : root.ram_status_text;
                    overflow: elide;
                    font-size: 20px;
                    color: Theme.text_primary;
                }
                Rectangle {
                    height: 18px;
                    background: Theme.progress_track;
                    clip: true;
                    Rectangle {
                        width: parent.width * Math.max(0.0, Math.min(100.0, root.ram_percent)) / 100.0;
                        height: parent.height;
                        background: Theme.teal_primary;
                        animate width { duration: 250ms; easing: ease-out; }
                    }
                }
                Text { text: root.ram_available ? "Memory usage" : root.ram_status_text; font-size: 11px; color: Theme.text_muted; }
            }
        }

        Rectangle {
            min-height: 180px;
            vertical-stretch: 1.125;
            background: Theme.card_bg;
            border-radius: Theme.radius_sm;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.space_md;
                spacing: Theme.space_sm;
                SectionHeading { title: "GPU TELEMETRY"; icon: "gpu"; }
                if root.gpu_available: VerticalLayout {
                    spacing: Theme.space_sm;
                    Text { text: root.gpu_name; font-size: 12px; color: Theme.text_muted; }
                    Text { text: Math.round(root.gpu_utilization) + "%"; font-size: 24px; font-weight: 700; color: Theme.accent_cyan; }
                    Rectangle { height: 1px; background: Theme.border; }
                    Text { text: "VRAM " + Math.round(root.gpu_vram_used_gib * 10.0) / 10.0 + " / " + Math.round(root.gpu_vram_total_gib * 10.0) / 10.0 + " GiB"; font-size: 11px; color: Theme.text_secondary; }
                    Text { text: Math.round(root.gpu_temperature_c) + " °C  •  " + Math.round(root.gpu_clock_mhz) + " MHz"; font-size: 11px; color: Theme.text_secondary; }
                }
                if !root.gpu_available: Text { text: root.gpu_status_text; font-size: 12px; color: Theme.text_muted; }
            }
        }

        Rectangle {
            min-height: 150px;
            vertical-stretch: 1;
            background: Theme.card_bg;
            border-radius: Theme.radius_sm;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.space_md;
                spacing: Theme.space_sm;
                SectionHeading { title: "NETWORK SPEEDS"; icon: "network"; }
                Rectangle { height: 1px; background: Theme.border; }
                Text { text: "RECEIVE"; font-size: 11px; font-weight: 700; color: Theme.text_muted; }
                Text { text: root.network_available ? Math.round(root.net_recv_kib * 10.0) / 10.0 + " KiB/s" : root.network_status_text; font-size: 20px; font-weight: 700; color: Theme.purple; }
                Text { text: root.network_available ? "SEND  " + Math.round(root.net_sent_kib * 10.0) / 10.0 + " KiB/s • all interfaces" : "Send unavailable"; overflow: elide; font-size: 11px; color: Theme.text_secondary; }
            }
        }
        }
    }
}
