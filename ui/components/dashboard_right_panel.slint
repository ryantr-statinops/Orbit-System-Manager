import { Theme } from "../theme.slint";
import { SectionHeading } from "section_heading.slint";
import { DashboardLinePlot, LinePlotSeries } from "line_plot.slint";
import { ScrollView } from "std-widgets.slint";

export component DashboardRightPanel inherits Rectangle {
    in property <float> ram_percent: 0.0;
    in property <bool> ram_available: false;
    in property <float> ram_used_gb: 0.0;
    in property <float> ram_total_gb: 0.0;
    in property <string> ram_status_text: "Waiting for samples";
    in property <string> ram_history_area_commands: "";
    in property <[LinePlotSeries]> ram_history_series: [];
    in property <bool> ram_history_has_data: false;
    in property <float> net_sent_kib: 0.0;
    in property <float> net_recv_kib: 0.0;
    in property <[LinePlotSeries]> network_history_series: [];
    in property <bool> network_history_has_data: false;
    in property <bool> network_available: false;
    in property <string> network_status_text: "Collecting first sample";
    in property <string> gpu_name: "Demo GPU";
    in property <bool> gpu_available: true;
    in property <string> gpu_status_text: "Demo data";
    in property <float> gpu_utilization: 0.0;
    in property <string> gpu_history_area_commands: "";
    in property <[LinePlotSeries]> gpu_history_series: [];
    in property <bool> gpu_history_has_data: false;
    in property <float> gpu_vram_used_gib: 0.0;
    in property <float> gpu_vram_total_gib: 8.0;
    in property <float> gpu_temperature_c: 0.0;
    in property <float> gpu_clock_mhz: 0.0;

    background: transparent;
    ScrollView {
        width: parent.width;
        height: parent.height;
        content-width: self.width;
        VerticalLayout {
            spacing: Theme.space_sm;

        Rectangle {
            min-height: 210px;
            vertical-stretch: 1;
            background: Theme.card_bg;
            border-radius: Theme.radius_sm;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.space_md;
                spacing: Theme.space_sm;
                SectionHeading { title: "System Memory (RAM)"; icon: "memory"; }
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.ram_available ? Math.round(root.ram_used_gb * 10.0) / 10.0 + " GiB" : "N/A";
                        font-size: 22px;
                        font-weight: 700;
                        color: Theme.teal_primary;
                    }
                    Text {
                        text: root.ram_available ? Math.round(root.ram_percent) + "%" : "";
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.text_primary;
                        vertical-alignment: center;
                    }
                }
                Text { text: root.ram_available ? "of " + Math.round(root.ram_total_gb * 10.0) / 10.0 + " GiB total" : root.ram_status_text; font-size: 11px; color: Theme.text_secondary; }
                if root.ram_available: Rectangle {
                    height: 18px;
                    background: Theme.progress_track;
                    clip: true;
                    Rectangle {
                        width: parent.width * Math.max(0.0, Math.min(100.0, root.ram_percent)) / 100.0;
                        height: parent.height;
                        background: Theme.teal_primary;
                        animate width { duration: 250ms; easing: ease-out; }
                    }
                }
                DashboardLinePlot {
                    horizontal-stretch: 1;
                    height: 76px;
                    area_commands: root.ram_history_area_commands;
                    area_brush: Theme.teal_primary.transparentize(0.84);
                    series: root.ram_history_series;
                    has_data: root.ram_history_has_data;
                    placeholder: root.ram_available ? "Memory history samples will appear here" : root.ram_status_text;
                }
            }
        }

        Rectangle {
            min-height: 180px;
            vertical-stretch: 1.125;
            background: Theme.card_bg;
            border-radius: Theme.radius_sm;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.space_md;
                spacing: Theme.space_sm;
                SectionHeading { title: "GPU Telemetry"; icon: "gpu"; }
                if root.gpu_available: VerticalLayout {
                    spacing: Theme.space_sm;
                    Text { text: root.gpu_name; overflow: elide; font-size: 12px; color: Theme.text_secondary; }
                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: Theme.space_xs;
                            Text { text: "Utilization"; font-size: 11px; color: Theme.text_muted; }
                            Text { text: Math.round(root.gpu_utilization) + "%"; font-size: 24px; font-weight: 700; color: Theme.accent_cyan; }
                        }
                        VerticalLayout {
                            spacing: Theme.space_xs;
                            alignment: end;
                            Text { text: "Temperature"; font-size: 11px; color: Theme.text_muted; horizontal-alignment: right; }
                            Text { text: Math.round(root.gpu_temperature_c) + " °C"; font-size: 18px; font-weight: 700; color: Theme.text_primary; horizontal-alignment: right; }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "VRAM"; font-size: 11px; color: Theme.text_muted; }
                        Text { text: Math.round(root.gpu_vram_used_gib * 10.0) / 10.0 + " / " + Math.round(root.gpu_vram_total_gib * 10.0) / 10.0 + " GiB"; font-size: 11px; font-weight: 600; color: Theme.text_secondary; }
                    }
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Clock"; font-size: 11px; color: Theme.text_muted; }
                        Text { text: Math.round(root.gpu_clock_mhz) + " MHz"; font-size: 11px; font-weight: 600; color: Theme.text_secondary; }
                    }
                    DashboardLinePlot {
                        horizontal-stretch: 1;
                        height: 76px;
                        area_commands: root.gpu_history_area_commands;
                        area_brush: Theme.accent_cyan.transparentize(0.84);
                        series: root.gpu_history_series;
                        has_data: root.gpu_history_has_data;
                        placeholder: "GPU history samples will appear here";
                    }
                }
                if !root.gpu_available: Text { text: root.gpu_status_text; font-size: 12px; color: Theme.text_muted; }
            }
        }

        Rectangle {
            min-height: 150px;
            vertical-stretch: 1;
            background: Theme.card_bg;
            border-radius: Theme.radius_sm;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.space_md;
                spacing: Theme.space_sm;
                SectionHeading { title: "Network Speeds"; icon: "network"; }
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    spacing: Theme.space_md;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.space_xs;
                        Text { text: "RECEIVE"; font-size: 11px; font-weight: 700; color: Theme.accent_cyan; }
                        Text {
                            text: root.network_available ? Math.round(root.net_recv_kib * 10.0) / 10.0 + " KiB/s" : "N/A";
                            overflow: elide;
                            font-size: 18px;
                            font-weight: 700;
                            color: Theme.text_primary;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.space_xs;
                        Text { text: "SEND"; font-size: 11px; font-weight: 700; color: Theme.success; }
                        Text {
                            text: root.network_available ? Math.round(root.net_sent_kib * 10.0) / 10.0 + " KiB/s" : "N/A";
                            overflow: elide;
                            font-size: 18px;
                            font-weight: 700;
                            color: Theme.text_primary;
                        }
                    }
                }
                Text {
                    text: root.network_available ? "Aggregate across all interfaces" : root.network_status_text;
                    font-size: 10px;
                    color: Theme.text_muted;
                }
                if root.network_available: DashboardLinePlot {
                    horizontal-stretch: 1;
                    height: 76px;
                    series: root.network_history_series;
                    has_data: root.network_history_has_data;
                    placeholder: "Network history samples will appear here";
                }
            }
        }
        }
    }
}
