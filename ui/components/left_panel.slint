// LeftPanel Component — CPU Cores, Memory & HUD Telemetry
import { Theme } from "../theme.slint";
import { CoreBar, CoreItem } from "core_bar.slint";
import { StatCard } from "stat_card.slint";

export component LeftPanel inherits Rectangle {
    in property <float> ram_percent: 0.0;
    in property <float> ram_used_gb: 0.0;
    in property <float> ram_total_gb: 0.0;
    in property <float> cpu_avg: 0.0;
    in property <float> cpu_std: 0.0;
    in property <float> cpu_var: 0.0;
    in property <[CoreItem]> cores;

    width: 310px;
    background: Theme.card_bg;
    border-radius: Theme.radius_md;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        // Memory Header
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "SYSTEM MEMORY";
                font-size: 12px;
                font-weight: 800;
                color: Theme.text_primary;
                letter-spacing: 0.5px;
            }
            Text {
                text: Math.round(root.ram_percent) + "%";
                font-size: 11px;
                font-weight: 700;
                color: Theme.accent;
            }
        }

        // RAM Progress Bar
        Rectangle {
            height: 12px;
            background: Theme.progress_track;
            border-radius: Theme.radius_sm;
            clip: true;
            Rectangle {
                x: 0;
                y: 0;
                width: Math.min(parent.width, Math.max(0px, parent.width * (root.ram_percent / 100.0)));
                height: parent.height;
                background: Theme.teal_primary;
                animate width { duration: 250ms; easing: ease-out; }
            }
        }

        Text {
            text: Math.round(root.ram_used_gb * 10.0) / 10.0 + " / " + Math.round(root.ram_total_gb * 10.0) / 10.0 + " GB";
            font-size: 11px;
            font-weight: 600;
            color: Theme.text_secondary;
        }

        Rectangle { height: 1px; background: Theme.border; }

        // CPU Cores Header
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "CPU CORES (16)";
                font-size: 12px;
                font-weight: 800;
                color: Theme.text_primary;
                letter-spacing: 0.5px;
            }
            Text {
                text: "AVG: " + Math.round(root.cpu_avg * 10.0) / 10.0 + "%";
                font-size: 11px;
                font-weight: 700;
                color: Theme.teal_primary;
            }
        }

        // 16 Core Bars
        for item[index] in root.cores: CoreBar {
            core_id: item.id;
            load: item.load;
        }

        Rectangle { height: 1px; background: Theme.border; }

        // HUD Statistics
        HorizontalLayout {
            spacing: 6px;
            StatCard {
                title: "AVG UTIL";
                value: Math.round(root.cpu_avg) + "%";
                value_color: Theme.teal_primary;
            }
            StatCard {
                title: "STD DEV";
                value: Math.round(root.cpu_std * 10.0) / 10.0 + "";
                value_color: Theme.accent;
            }
            StatCard {
                title: "VARIANCE";
                value: Math.round(root.cpu_var) + "";
                value_color: Theme.purple;
            }
        }
    }
}
