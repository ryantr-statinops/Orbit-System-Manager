import { Theme } from "../theme.slint";
import { CoreMatrix, CoreRow } from "core_matrix.slint";
import { DashboardLinePlot, LinePlotSeries } from "line_plot.slint";
import { SectionHeading } from "section_heading.slint";
import { ScrollView } from "std-widgets.slint";

export component DashboardLeftPanel inherits Rectangle {
    in property <float> cpu_avg: 0.0;
    in property <float> cpu_std: 0.0;
    in property <float> cpu_var: 0.0;
    in property <string> cpu_history_area_commands: "";
    in property <[LinePlotSeries]> cpu_history_series: [];
    in property <bool> cpu_history_has_data: false;
    in property <bool> cpu_available: false;
    in property <string> cpu_status_text: "Waiting for telemetry";
    in property <string> cpu_name: "N/A";
    in property <string> cpu_frequency: "N/A";
    in property <string> cpu_physical_cores: "N/A";
    in property <int> cpu_logical_cores: 0;
    in property <[CoreRow]> core_rows: [];
    in property <bool> show_cpu_summary: true;
    in property <bool> show_logical_processors: true;
    in property <bool> show_cpu_history: true;

    background: transparent;
    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: Theme.space_sm;

        if root.show_cpu_summary: Rectangle {
            height: 170px;
            background: Theme.card_bg;
            border-radius: Theme.radius_sm;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.space_md;
                spacing: Theme.space_sm;
                SectionHeading { title: "CPU Summary"; icon: "cpu"; }
                Text { text: root.cpu_name; overflow: elide; font-size: 12px; color: Theme.text_primary; }
                HorizontalLayout {
                    spacing: Theme.space_sm;
                    VerticalLayout {
                        Text { text: "Average Utilization"; font-size: 12px; color: Theme.text_muted; }
                        Text { text: "Std Dev (σ)"; font-size: 11px; color: Theme.text_muted; }
                        Text { text: "Variance (σ²)"; font-size: 11px; color: Theme.text_muted; }
                    }
                    VerticalLayout {
                        alignment: end;
                        Text { text: root.cpu_available ? Math.round(root.cpu_avg * 10.0) / 10.0 + "%" : "N/A"; font-size: 22px; font-weight: 700; color: Theme.accent_cyan; horizontal-alignment: right; }
                        Text { text: root.cpu_available ? Math.round(root.cpu_std * 100.0) / 100.0 + " pp" : "N/A"; font-size: 12px; font-weight: 700; color: Theme.text_primary; horizontal-alignment: right; }
                        Text { text: root.cpu_available ? Math.round(root.cpu_var * 100.0) / 100.0 + " pp²" : "N/A"; font-size: 12px; font-weight: 700; color: Theme.text_primary; horizontal-alignment: right; }
                    }
                }
                if root.cpu_available: Rectangle {
                    height: 5px;
                    background: Theme.progress_track;
                    border-radius: 2px;
                    clip: true;
                    Rectangle { width: parent.width * Math.max(0.0, Math.min(100.0, root.cpu_avg)) / 100.0; height: parent.height; background: Theme.teal_primary; }
                }
                Text {
                    text: root.cpu_frequency + "  •  " + root.cpu_physical_cores + " physical / " + root.cpu_logical_cores + " logical";
                    overflow: elide;
                    font-size: 11px;
                    color: Theme.text_muted;
                }
            }
        }

        if root.show_logical_processors: Rectangle {
            vertical-stretch: 1;
            background: Theme.card_bg;
            border-radius: Theme.radius_sm;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.space_md;
                spacing: Theme.space_sm;
                HorizontalLayout {
                    SectionHeading { horizontal-stretch: 1; title: "Logical Processors"; icon: "processor"; }
                    Text { text: "(" + root.cpu_logical_cores + ")"; font-size: 12px; font-weight: 700; color: Theme.text_muted; }
                }
                if root.cpu_logical_cores == 0: Text { text: root.cpu_status_text; font-size: 12px; color: Theme.text_muted; }
                ScrollView {
                    CoreMatrix { rows: root.core_rows; }
                }
            }
        }

        if root.show_cpu_history: Rectangle {
            height: 170px;
            background: Theme.card_bg;
            border-radius: Theme.radius_sm;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.space_md;
                spacing: Theme.space_sm;
                SectionHeading { title: "CPU History"; icon: "cpu"; }
                Rectangle { height: 1px; background: Theme.border; }
                DashboardLinePlot {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    area_commands: root.cpu_history_area_commands;
                    series: root.cpu_history_series;
                    has_data: root.cpu_history_has_data;
                    placeholder: "CPU history samples will appear here";
                }
            }
        }
    }
}
