// CoreBar Component — Dark Theme Responsive Progress Bar
import { Theme } from "../theme.slint";

export struct CoreItem {
    id: int,
    load: float, // 0.0 - 100.0
}

export component CoreBar inherits Rectangle {
    in property <int> core_id: 0;
    in property <float> load: 0.0;

    height: 22px;
    background: Theme.progress_track;
    border-radius: Theme.radius_sm;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    // Animated dynamic load fill with dark-theme telemetry gradient
    Rectangle {
        x: 0;
        y: 0;
        width: Math.min(parent.width, Math.max(0px, parent.width * (root.load / 100.0)));
        height: parent.height;
        background: root.load > 85.0 ? Theme.danger : (root.load > 55.0 ? Theme.warning : Theme.teal_primary);
        animate width { duration: 250ms; easing: ease-out; }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: "C" + root.core_id;
            font-size: 11px;
            font-weight: 700;
            color: root.load > 60.0 ? Theme.text_on_accent : Theme.text_primary;
            vertical-alignment: center;
        }
        Text {
            text: Math.round(root.load) + "%";
            font-size: 11px;
            font-weight: 600;
            color: root.load > 60.0 ? Theme.text_on_accent : Theme.text_secondary;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}
