// ResourceCard Component — Task Manager Performance Tab Selector Item with Gradient Meter
import { Theme } from "../theme.slint";

export component ResourceCard inherits Rectangle {
    in property <string> title: "CPU";
    in property <string> value_text: "0%";
    in property <string> sub_text: "";
    in property <float> percent: 0.0;
    in property <bool> show_meter: true;
    in property <brush> meter_brush: Theme.gradient_cpu;

    height: 62px;
    background: Theme.card_bg;
    border-radius: Theme.radius_sm;
    clip: true;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 4px;

        HorizontalLayout {
            alignment: space-between;
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 700;
                color: Theme.text_primary;
            }
            Text {
                text: root.value_text;
                font-size: 12px;
                font-weight: 600;
                color: Theme.text_secondary;
            }
        }

        if root.sub_text != "": Text {
            text: root.sub_text;
            font-size: 10px;
            color: Theme.text_muted;
        }

        // Gradient meter line
        if root.show_meter: Rectangle {
            height: 3px;
            background: Theme.progress_track;
            border-radius: 1px;
            clip: true;
            Rectangle {
                x: 0;
                y: 0;
                width: Math.min(parent.width, Math.max(0px, parent.width * (root.percent / 100.0)));
                height: parent.height;
                background: root.meter_brush;
                animate width { duration: 250ms; easing: ease-out; }
            }
        }
    }
}
