import { Theme } from "theme.slint";
import { CoreMatrix, CoreRow } from "components/core_matrix.slint";
import { Viewport3D } from "components/viewport_3d.slint";
import { KpiCard } from "components/kpi_card.slint";
import { ScrollView } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Orbit System Manager | System Performance";
    min-width: 720px;
    min-height: 520px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.app_bg;
    default-font-family: Theme.default_font;

    in property <float> cpu_avg: 0.0;
    in property <float> cpu_std: 0.0;
    in property <float> cpu_var: 0.0;
    in property <bool> cpu_available: false;
    in property <string> cpu_status_text: "Waiting for telemetry";
    in property <string> cpu_name: "N/A";
    in property <string> cpu_frequency: "N/A";
    in property <string> cpu_physical_cores: "N/A";
    in property <int> cpu_logical_cores: 0;
    in property <float> ram_percent: 0.0;
    in property <bool> ram_available: false;
    in property <float> ram_used_gb: 0.0;
    in property <float> ram_total_gb: 0.0;
    in property <float> net_sent_kib: 0.0;
    in property <float> net_recv_kib: 0.0;
    in property <bool> network_available: false;
    in property <string> network_status_text: "Collecting first sample";
    in property <[CoreRow]> core_rows: [];
    in property <int> history_samples: 0;
    in property <int> history_seconds: 0;

    in property <image> viewport_3d_frame;
    in property <bool> has_3d_frame: true;
    callback rotate_3d(length, length);
    callback pan_3d(length, length);
    callback zoom_3d(length);
    callback resize_viewport(length, length);

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 58px;
            background: Theme.app_bg;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                alignment: space-between;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;
                    Text {
                        text: "Orbit System Manager";
                        font-size: 15px;
                        font-weight: 700;
                        color: Theme.text_primary;
                    }
                    Text {
                        text: "SYSTEM PERFORMANCE";
                        font-size: 10px;
                        font-weight: 600;
                        color: Theme.text_muted;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 4px;
                        background: Theme.success;
                    }
                    Text {
                        text: "LIVE";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.success;
                    }
                    Text {
                        text: "1 second updates";
                        font-size: 11px;
                        color: Theme.text_muted;
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }

        ScrollView {
            VerticalLayout {
                padding: 20px;
                spacing: 16px;

                HorizontalLayout {
                    spacing: 12px;
                    KpiCard {
                        title: "CPU";
                        value_text: root.cpu_available ? Math.round(root.cpu_avg) + "%" : "N/A";
                        detail_text: root.cpu_available ? root.cpu_logical_cores + " logical processors" : root.cpu_status_text;
                        percent: root.cpu_avg;
                        show_meter: root.cpu_available;
                        accent: Theme.accent;
                    }
                    KpiCard {
                        title: "MEMORY";
                        value_text: root.ram_available ? Math.round(root.ram_percent) + "%" : "N/A";
                        detail_text: root.ram_available ? Math.round(root.ram_used_gb * 10.0) / 10.0 + " / " + Math.round(root.ram_total_gb * 10.0) / 10.0 + " GiB" : "Memory telemetry unavailable";
                        percent: root.ram_percent;
                        show_meter: root.ram_available;
                        accent: Theme.teal_primary;
                    }
                    KpiCard {
                        title: "NETWORK";
                        value_text: root.network_available ? "Receive " + Math.round(root.net_recv_kib) + " KiB/s" : "Unavailable";
                        detail_text: root.network_available ? "Send " + Math.round(root.net_sent_kib) + " KiB/s • all interfaces" : root.network_status_text;
                        accent: Theme.purple;
                    }
                    KpiCard {
                        title: "GPU";
                        value_text: "Unavailable";
                        detail_text: "GPU telemetry is not supported";
                        accent: Theme.warning;
                    }
                }

                Viewport3D {
                    height: 440px;
                    frame: root.viewport_3d_frame;
                    has_frame: root.has_3d_frame;
                    cpu_avg: root.cpu_avg;
                    cpu_std: root.cpu_std;
                    cpu_var: root.cpu_var;
                    cpu_available: root.cpu_available;
                    cpu_logical_count: root.cpu_logical_cores;
                    history_samples: root.history_samples;
                    history_seconds: root.history_seconds;
                    rotate_drag(dx, dy) => { root.rotate_3d(dx, dy); }
                    pan_drag(dx, dy) => { root.pan_3d(dx, dy); }
                    zoom_scroll(delta) => { root.zoom_3d(delta); }
                    resize_viewport(width, height) => { root.resize_viewport(width, height); }
                }

                VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "LOGICAL PROCESSORS (" + root.cpu_logical_cores + ")";
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.text_primary;
                        }
                        Text {
                            text: root.cpu_available ? "Avg " + Math.round(root.cpu_avg * 10.0) / 10.0 + "%" : "Waiting for CPU data";
                            font-size: 11px;
                            color: Theme.text_secondary;
                        }
                    }
                    if root.cpu_logical_cores == 0: Text {
                        text: "Processor telemetry is not available yet.";
                        font-size: 12px;
                        color: Theme.text_muted;
                    }
                    CoreMatrix { rows: root.core_rows; }
                }

                Rectangle {
                    height: 84px;
                    background: Theme.card_bg;
                    border-radius: Theme.radius_md;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding: 14px;
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "CPU MODEL"; font-size: 10px; color: Theme.text_muted; }
                            Text { text: root.cpu_name; font-size: 13px; font-weight: 700; color: Theme.text_primary; }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "CURRENT SPEED"; font-size: 10px; color: Theme.text_muted; }
                            Text { text: root.cpu_frequency; font-size: 13px; font-weight: 700; color: Theme.text_primary; }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "PHYSICAL / LOGICAL"; font-size: 10px; color: Theme.text_muted; }
                            Text { text: root.cpu_physical_cores + " / " + root.cpu_logical_cores; font-size: 13px; font-weight: 700; color: Theme.text_primary; }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "UTILIZATION VARIANCE"; font-size: 10px; color: Theme.text_muted; }
                            Text { text: root.cpu_available ? Math.round(root.cpu_std * 100.0) / 100.0 + " std dev" : "N/A"; font-size: 13px; font-weight: 700; color: Theme.text_primary; }
                        }
                    }
                }
            }
        }
    }
}
