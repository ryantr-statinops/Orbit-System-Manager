// Orbit System Manager — Slint Master Window Layout
// Modular Architecture & Dark Theme Design Tokens

import { Theme } from "theme.slint";
import { CoreItem } from "components/core_bar.slint";
import { LeftPanel } from "components/left_panel.slint";
import { Viewport3D } from "components/viewport_3d.slint";
import { RightPanel } from "components/right_panel.slint";

export component AppWindow inherits Window {
    title: "Orbit System Manager — Pure Native Rust & Slint";
    min-width: 1024px;
    min-height: 720px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.app_bg;
    default-font-family: Theme.default_font;

    // Hardware Telemetry Properties (Bound to Rust sysinfo)
    in property <float> cpu_avg: 0.0;
    in property <float> cpu_std: 0.0;
    in property <float> cpu_var: 0.0;
    in property <float> ram_percent: 0.0;
    in property <float> ram_used_gb: 0.0;
    in property <float> ram_total_gb: 0.0;
    in property <float> net_sent_kbps: 0.0;
    in property <float> net_recv_kbps: 0.0;
    in property <float> gpu_load: 0.0;
    in property <float> gpu_temp: 0.0;
    in property <string> gpu_name: "Primary GPU";
    in property <[CoreItem]> cores: [
        { id: 0, load: 12.0 }, { id: 1, load: 24.0 }, { id: 2, load: 45.0 }, { id: 3, load: 18.0 },
        { id: 4, load: 65.0 }, { id: 5, load: 30.0 }, { id: 6, load: 82.0 }, { id: 7, load: 14.0 },
        { id: 8, load: 28.0 }, { id: 9, load: 50.0 }, { id: 10, load: 38.0 }, { id: 11, load: 72.0 },
        { id: 12, load: 19.0 }, { id: 13, load: 41.0 }, { id: 14, load: 60.0 }, { id: 15, load: 22.0 }
    ];

    // 3D Viewport Bindings
    in property <image> viewport_3d_frame;
    in property <bool> has_3d_frame: true;
    callback rotate_3d(length, length);
    callback pan_3d(length, length);
    callback zoom_3d(length);

    VerticalLayout {
        padding: 12px;
        spacing: 12px;

        // ---------- TOP BAR ----------
        Rectangle {
            height: 48px;
            background: Theme.card_bg;
            border-radius: Theme.radius_md;
            border-width: 1px;
            border-color: Theme.border;
            padding: 8px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                // Branding
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "🛸";
                        font-size: 18px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "ORBIT SYSTEM MANAGER";
                        font-size: 14px;
                        font-weight: 800;
                        color: Theme.text_primary;
                        vertical-alignment: center;
                        letter-spacing: 0.8px;
                    }
                }

                // Status Pills
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        background: #0f2d1e;
                        border-radius: Theme.radius_sm;
                        border-width: 1px;
                        border-color: Theme.success;
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: "● NATIVE SLINT ENGINE";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.success;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        background: Theme.sub_card_bg;
                        border-radius: Theme.radius_sm;
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "1 HZ SAMPLING";
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.text_secondary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ---------- MAIN 3-COLUMN DASHBOARD ----------
        HorizontalLayout {
            spacing: 12px;

            // ===== Left Column =====
            LeftPanel {
                ram_percent: root.ram_percent;
                ram_used_gb: root.ram_used_gb;
                ram_total_gb: root.ram_total_gb;
                cpu_avg: root.cpu_avg;
                cpu_std: root.cpu_std;
                cpu_var: root.cpu_var;
                cores: root.cores;
            }

            // ===== Center Column (3D Viewport) =====
            Viewport3D {
                frame: root.viewport_3d_frame;
                has_frame: root.has_3d_frame;
                rotate_drag(dx, dy) => { root.rotate_3d(dx, dy); }
                pan_drag(dx, dy) => { root.pan_3d(dx, dy); }
                zoom_scroll(delta) => { root.zoom_3d(delta); }
            }

            // ===== Right Column =====
            RightPanel {
                gpu_name: root.gpu_name;
                gpu_load: root.gpu_load;
                gpu_temp: root.gpu_temp;
                net_sent_kbps: root.net_sent_kbps;
                net_recv_kbps: root.net_recv_kbps;
            }
        }
    }
}
