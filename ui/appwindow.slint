import { Theme } from "theme.slint";
import { DashboardLeftPanel } from "components/dashboard_left_panel.slint";
import { DashboardRightPanel } from "components/dashboard_right_panel.slint";
import { Viewport3D, TerrainAxisLabel } from "components/viewport_3d.slint";
import { PanelSplitter } from "components/panel_splitter.slint";
import { DashboardAction } from "components/dashboard_action.slint";
import { CoreRow } from "components/core_matrix.slint";
import { LinePlotSeries } from "components/line_plot.slint";
import { ScrollView } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Orbit System Manager";
    min-width: 720px;
    min-height: 520px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.app_bg;

    in property <float> cpu_avg: 0.0;
    in property <float> cpu_std: 0.0;
    in property <float> cpu_var: 0.0;
    in property <string> cpu_history_area_commands: "";
    in property <[LinePlotSeries]> cpu_history_series: [];
    in property <bool> cpu_history_has_data: false;
    in property <bool> cpu_available: false;
    in property <string> cpu_status_text: "Waiting for telemetry";
    in property <string> cpu_name: "N/A";
    in property <string> cpu_frequency: "N/A";
    in property <string> cpu_physical_cores: "N/A";
    in property <int> cpu_logical_cores: 0;
    in property <float> ram_percent: 0.0;
    in property <bool> ram_available: false;
    in property <float> ram_used_gb: 0.0;
    in property <float> ram_total_gb: 0.0;
    in property <string> ram_status_text: "Waiting for samples";
    in property <string> ram_history_area_commands: "";
    in property <[LinePlotSeries]> ram_history_series: [];
    in property <bool> ram_history_has_data: false;
    in property <float> net_sent_kib: 0.0;
    in property <float> net_recv_kib: 0.0;
    in property <[LinePlotSeries]> network_history_series: [];
    in property <bool> network_history_has_data: false;
    in property <bool> network_available: false;
    in property <string> network_status_text: "Collecting first sample";
    in property <string> gpu_name: "Demo GPU";
    in property <bool> gpu_available: true;
    in property <string> gpu_status_text: "Demo data";
    in property <float> gpu_utilization: 0.0;
    in property <string> gpu_history_area_commands: "";
    in property <[LinePlotSeries]> gpu_history_series: [];
    in property <bool> gpu_history_has_data: false;
    in property <float> gpu_vram_used_gib: 0.0;
    in property <float> gpu_vram_total_gib: 8.0;
    in property <float> gpu_temperature_c: 0.0;
    in property <float> gpu_clock_mhz: 0.0;
    in property <bool> demo_paused: false;
    in property <[CoreRow]> core_rows: [];
    in property <int> history_samples: 0;
    in property <int> history_seconds: 0;
    in property <[TerrainAxisLabel]> terrain_axis_labels: [];
    in-out property <length> left_sidebar_width: 290px;
    in-out property <length> right_sidebar_width: 290px;
    in-out property <bool> left_sidebar_visible: true;
    in-out property <bool> right_sidebar_visible: true;

    in property <image> viewport_3d_frame;
    in property <bool> has_3d_frame: true;
    callback rotate_3d(length, length);
    callback pan_3d(length, length);
    callback zoom_3d(length);
    callback resize_viewport(length, length);
    callback reset_3d_view();
    callback resize_core_grid(length);
    callback toggle_demo_pause();
    changed width => { root.resize_core_grid(root.width); }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 38px;
            background: Theme.editor_bg;
            HorizontalLayout {
                padding-left: Theme.space_sm;
                padding-right: Theme.space_sm;
                alignment: space-between;
                HorizontalLayout {
                    spacing: Theme.space_sm;
                    alignment: center;
                    DashboardAction {
                        width: 28px;
                        height: 28px;
                        text: root.left_sidebar_visible ? "<" : ">";
                        accessible_name: root.left_sidebar_visible ? "Hide left sidebar" : "Show left sidebar";
                        activated => { root.left_sidebar_visible = !root.left_sidebar_visible; }
                    }
                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.success; }
                    Text { text: "DEMO DATA"; font-size: 11px; color: Theme.warning; }
                    if root.demo_paused: Text { text: "PAUSED"; font-size: 10px; font-weight: 700; color: Theme.warning; }
                }
                Text { text: "ORBIT SYSTEM MANAGER"; font-size: 14px; font-weight: 700; color: Theme.text_primary; }
                HorizontalLayout {
                    spacing: Theme.space_sm;
                    alignment: center;
                    Text { text: "1 second sampling"; font-size: 11px; color: Theme.text_muted; }
                    DashboardAction {
                        width: 72px;
                        height: 28px;
                        text: root.demo_paused ? "Resume" : "Pause";
                        accessible_name: root.demo_paused ? "Resume demo playback" : "Pause demo playback";
                        activated => { root.toggle_demo_pause(); }
                    }
                    DashboardAction {
                        width: 28px;
                        height: 28px;
                        text: root.right_sidebar_visible ? ">" : "<";
                        accessible_name: root.right_sidebar_visible ? "Hide right sidebar" : "Show right sidebar";
                        activated => { root.right_sidebar_visible = !root.right_sidebar_visible; }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }

        if root.width >= 1060px: HorizontalLayout {
            vertical-stretch: 1;
            padding: Theme.space_sm;
            spacing: 0px;
            if root.left_sidebar_visible: DashboardLeftPanel {
                width: root.left_sidebar_width;
                cpu_avg: root.cpu_avg;
                cpu_std: root.cpu_std;
                cpu_var: root.cpu_var;
                cpu_history_area_commands: root.cpu_history_area_commands;
                cpu_history_series: root.cpu_history_series;
                cpu_history_has_data: root.cpu_history_has_data;
                cpu_available: root.cpu_available;
                cpu_status_text: root.cpu_status_text;
                cpu_name: root.cpu_name;
                cpu_frequency: root.cpu_frequency;
                cpu_physical_cores: root.cpu_physical_cores;
                cpu_logical_cores: root.cpu_logical_cores;
                core_rows: root.core_rows;
            }
            if root.left_sidebar_visible: PanelSplitter {
                width: 5px;
                drag_delta(delta) => {
                    root.left_sidebar_width = Math.max(290px, Math.min(root.width - 676px, Math.min(380px, root.left_sidebar_width + delta)));
                }
                accessible_name: "Resize left sidebar";
                current_value: root.left_sidebar_width / 1px;
            }
            Viewport3D {
                horizontal-stretch: 1;
                frame: root.viewport_3d_frame;
                has_frame: root.has_3d_frame;
                cpu_avg: root.cpu_avg;
                cpu_std: root.cpu_std;
                cpu_var: root.cpu_var;
                cpu_available: root.cpu_available;
                cpu_logical_count: root.cpu_logical_cores;
                history_samples: root.history_samples;
                history_seconds: root.history_seconds;
                axis_labels: root.terrain_axis_labels;
                rotate_drag(dx, dy) => { root.rotate_3d(dx, dy); }
                pan_drag(dx, dy) => { root.pan_3d(dx, dy); }
                zoom_scroll(delta) => { root.zoom_3d(delta); }
                resize_viewport(width, height) => { root.resize_viewport(width, height); }
                reset_view() => { root.reset_3d_view(); }
            }
            if root.right_sidebar_visible: PanelSplitter {
                width: 5px;
                drag_delta(delta) => {
                    root.right_sidebar_width = Math.max(290px, Math.min(root.width - 676px, Math.min(380px, root.right_sidebar_width - delta)));
                }
                accessible_name: "Resize right sidebar";
                current_value: root.right_sidebar_width / 1px;
                value_direction: -1;
            }
            if root.right_sidebar_visible: DashboardRightPanel {
                width: root.right_sidebar_width;
                ram_percent: root.ram_percent;
                ram_available: root.ram_available;
                ram_used_gb: root.ram_used_gb;
                ram_total_gb: root.ram_total_gb;
                ram_status_text: root.ram_status_text;
                ram_history_area_commands: root.ram_history_area_commands;
                ram_history_series: root.ram_history_series;
                ram_history_has_data: root.ram_history_has_data;
                net_sent_kib: root.net_sent_kib;
                net_recv_kib: root.net_recv_kib;
                network_history_series: root.network_history_series;
                network_history_has_data: root.network_history_has_data;
                network_available: root.network_available;
                network_status_text: root.network_status_text;
                gpu_name: root.gpu_name;
                gpu_available: root.gpu_available;
                gpu_status_text: root.gpu_status_text;
                gpu_utilization: root.gpu_utilization;
                gpu_history_area_commands: root.gpu_history_area_commands;
                gpu_history_series: root.gpu_history_series;
                gpu_history_has_data: root.gpu_history_has_data;
                gpu_vram_used_gib: root.gpu_vram_used_gib;
                gpu_vram_total_gib: root.gpu_vram_total_gib;
                gpu_temperature_c: root.gpu_temperature_c;
                gpu_clock_mhz: root.gpu_clock_mhz;
            }
        }

        if root.width < 1060px: ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            content-width: self.width;
            VerticalLayout {
                padding: Theme.space_sm;
                spacing: Theme.space_sm;
                DashboardLeftPanel {
                    height: 170px;
                    show_logical_processors: false;
                    show_cpu_history: false;
                    cpu_avg: root.cpu_avg;
                    cpu_std: root.cpu_std;
                    cpu_var: root.cpu_var;
                    cpu_history_area_commands: root.cpu_history_area_commands;
                    cpu_history_series: root.cpu_history_series;
                    cpu_history_has_data: root.cpu_history_has_data;
                    cpu_available: root.cpu_available;
                    cpu_status_text: root.cpu_status_text;
                    cpu_name: root.cpu_name;
                    cpu_frequency: root.cpu_frequency;
                    cpu_physical_cores: root.cpu_physical_cores;
                    cpu_logical_cores: root.cpu_logical_cores;
                    core_rows: root.core_rows;
                }
                Viewport3D {
                    height: 480px;
                    frame: root.viewport_3d_frame;
                    has_frame: root.has_3d_frame;
                    cpu_avg: root.cpu_avg;
                    cpu_std: root.cpu_std;
                    cpu_var: root.cpu_var;
                    cpu_available: root.cpu_available;
                    cpu_logical_count: root.cpu_logical_cores;
                    history_samples: root.history_samples;
                    history_seconds: root.history_seconds;
                    axis_labels: root.terrain_axis_labels;
                    rotate_drag(dx, dy) => { root.rotate_3d(dx, dy); }
                    pan_drag(dx, dy) => { root.pan_3d(dx, dy); }
                    zoom_scroll(delta) => { root.zoom_3d(delta); }
                    resize_viewport(width, height) => { root.resize_viewport(width, height); }
                    reset_view() => { root.reset_3d_view(); }
                }
                DashboardLeftPanel {
                    height: 430px;
                    show_cpu_summary: false;
                    cpu_avg: root.cpu_avg;
                    cpu_std: root.cpu_std;
                    cpu_var: root.cpu_var;
                    cpu_history_area_commands: root.cpu_history_area_commands;
                    cpu_history_series: root.cpu_history_series;
                    cpu_history_has_data: root.cpu_history_has_data;
                    cpu_available: root.cpu_available;
                    cpu_status_text: root.cpu_status_text;
                    cpu_name: root.cpu_name;
                    cpu_frequency: root.cpu_frequency;
                    cpu_physical_cores: root.cpu_physical_cores;
                    cpu_logical_cores: root.cpu_logical_cores;
                    core_rows: root.core_rows;
                }
                DashboardRightPanel {
                    height: 680px;
                    ram_percent: root.ram_percent;
                    ram_available: root.ram_available;
                    ram_used_gb: root.ram_used_gb;
                    ram_total_gb: root.ram_total_gb;
                    ram_status_text: root.ram_status_text;
                    ram_history_area_commands: root.ram_history_area_commands;
                    ram_history_series: root.ram_history_series;
                    ram_history_has_data: root.ram_history_has_data;
                    net_sent_kib: root.net_sent_kib;
                    net_recv_kib: root.net_recv_kib;
                    network_history_series: root.network_history_series;
                    network_history_has_data: root.network_history_has_data;
                    network_available: root.network_available;
                    network_status_text: root.network_status_text;
                    gpu_name: root.gpu_name;
                    gpu_available: root.gpu_available;
                    gpu_status_text: root.gpu_status_text;
                    gpu_utilization: root.gpu_utilization;
                    gpu_history_area_commands: root.gpu_history_area_commands;
                    gpu_history_series: root.gpu_history_series;
                    gpu_history_has_data: root.gpu_history_has_data;
                    gpu_vram_used_gib: root.gpu_vram_used_gib;
                    gpu_vram_total_gib: root.gpu_vram_total_gib;
                    gpu_temperature_c: root.gpu_temperature_c;
                    gpu_clock_mhz: root.gpu_clock_mhz;
                }
            }
        }
    }
}
